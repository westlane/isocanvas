{
  "name": "@westlane/isocanvas",
  "version": "0.1.0",
  "description": "Isometric diagram canvas — viewport math, dot grid, drag snap, SVG bbox helpers, iso node decoration",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/westlane/isocanvas.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js",
      "default": "./dist/persistence/index.js"
    },
    "./layout": {
      "types": "./dist/layout-entry.d.ts",
      "import": "./dist/layout-entry.js",
      "default": "./dist/layout-entry.js"
    },
    "./dot-grid.css": "./theme/layout/dot-grid.css",
    "./layout.css": "./theme/layout/layout.css",
    "./camera.css": "./theme/camera/camera.css",
    "./canvas-chrome.css": "./theme/canvas-chrome.css",
    "./theme/tokens.css": "./theme/tokens.css",
    "./theme/schemes.css": "./theme/schemes.css",
    "./theme/schemes/*": "./theme/schemes/*",
    "./theme/diagram-surfaces.css": "./theme/diagram-surfaces.css",
    "./theme/wireframe.css": "./theme/wireframe.css"
  },
  "files": [
    "dist",
    "theme",
    "README.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/persistence.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn build",
    "pretest": "yarn build",
    "demo": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "yarn typecheck && yarn build && yarn test && yarn check:neutral",
    "check:neutral": "node scripts/check-neutral.mjs",
    "build:theme-schemes": "IC_GENERATE=1 vitest run"
  },
  "sideEffects": false,
  "dependencies": {
    "@elchininet/isometric": "^4.0.0"
  },
  "peerDependencies": {
    "loro.js": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "loro.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/feather-icons": "^4",
    "@types/node": "^22.15.0",
    "@westlane/pino-blanc": "portal:../pino-blanc",
    "feather-icons": "^4.29.2",
    "happy-dom": "^20.0.10",
    "loro.js": "^0.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependenciesMeta": {
    "@westlane/pino-blanc@0.1.4": {
      "unplugged": true
    }
  }
}
